# Kopieren nach /opt/arcane/.env, Rechte setzen: chmod 600 .env
# Schlüssel erzeugen:  openssl rand -hex 32
ENCRYPTION_KEY=HIER_GENERIERTEN_SCHLUESSEL_EINTRAGEN

# Öffentliche URL (hinter Reverse Proxy: https://arcane.example.org, ohne :3552)
APP_URL=http://localhost:3552

# UID/GID des Benutzers, dem /opt/stacks gehört (id -u / id -g)
PUID=1000
PGID=1000
